.page {
  padding: 24rpx 24rpx 80rpx;
}

.sec-title {
  font-size: 26rpx;
  color: #9AA1AE;
  margin: 32rpx 8rpx 16rpx;
}

.group {
  padding: 8rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F2F4F8;
}

.row-label {
  font-size: 30rpx;
}

.row-value {
  font-size: 28rpx;
  color: #8A93A6;
}

.st-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F4F8;
}

.st-label {
  flex: 1;
  font-size: 28rpx;
}

.st-time {
  font-size: 28rpx;
  color: #4C7DFF;
  padding: 8rpx 20rpx;
  background: #F5F7FF;
  border-radius: 12rpx;
}

.st-sep {
  margin: 0 16rpx;
  color: #C0C6D1;
}

.tip {
  font-size: 24rpx;
  color: #B6BCC8;
  line-height: 1.6;
  padding: 24rpx 0;
}

.act-btn {
  text-align: center;
  font-size: 30rpx;
  color: #4C7DFF;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F2F4F8;
}

.act-btn.danger {
  color: #FA5151;
}

.about {
  text-align: center;
  color: #C0C6D1;
  font-size: 24rpx;
  margin-top: 48rpx;
}
